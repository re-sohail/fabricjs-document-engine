{
  "name": "fabricjs-document-engine",
  "version": "1.3.0",
  "description": "Fabric.js save and load, undo and redo, and autosave for an existing canvas: stable object ids, custom objects, copy and paste, SVG import, PNG, SVG and PDF export, and recovery.",
  "keywords": [
    "fabricjs",
    "fabric.js",
    "fabric",
    "fabric js",
    "canvas",
    "canvas editor",
    "fabricjs editor",
    "design editor",
    "image editor",
    "undo redo",
    "undo",
    "redo",
    "history",
    "save canvas json",
    "load from json",
    "tojson",
    "loadfromjson",
    "serialization",
    "autosave",
    "custom objects",
    "custom properties",
    "object id",
    "export svg",
    "export image",
    "text on path",
    "import svg",
    "layers",
    "copy paste",
    "pdf",
    "export pdf",
    "recovery",
    "indexeddb",
    "react",
    "react hooks",
    "nextjs",
    "vue",
    "svelte",
    "typescript",
    "fabricjs document engine"
  ],
  "license": "MIT",
  "author": "Sohail Khan (https://me.jscrate.dev)",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "schema",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./storage": {
      "import": {
        "types": "./dist/storage.d.ts",
        "default": "./dist/storage.js"
      },
      "require": {
        "types": "./dist/storage.d.cts",
        "default": "./dist/storage.cjs"
      }
    },
    "./recovery": {
      "import": {
        "types": "./dist/recovery.d.ts",
        "default": "./dist/recovery.js"
      },
      "require": {
        "types": "./dist/recovery.d.cts",
        "default": "./dist/recovery.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./pdf": {
      "import": {
        "types": "./dist/pdf.d.ts",
        "default": "./dist/pdf.js"
      },
      "require": {
        "types": "./dist/pdf.d.cts",
        "default": "./dist/pdf.cjs"
      }
    },
    "./text": {
      "import": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "require": {
        "types": "./dist/text.d.cts",
        "default": "./dist/text.cjs"
      }
    },
    "./performance": {
      "import": {
        "types": "./dist/performance.d.ts",
        "default": "./dist/performance.js"
      },
      "require": {
        "types": "./dist/performance.d.cts",
        "default": "./dist/performance.cjs"
      }
    },
    "./filters": {
      "import": {
        "types": "./dist/filters.d.ts",
        "default": "./dist/filters.js"
      },
      "require": {
        "types": "./dist/filters.d.cts",
        "default": "./dist/filters.cjs"
      }
    },
    "./schema/document-v1.json": "./schema/document-v1.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node scripts/verify-build.mjs && npm run lint:publint && npm run lint:attw",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tools.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:browser": "vitest run --project browser-fabric7 --project browser-fabric6 --project browser-firefox --project browser-webkit",
    "test:watch": "vitest",
    "lint:publint": "publint --strict",
    "lint:attw": "attw --pack . --profile node16",
    "prepublishOnly": "npm run build",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "fabric": "^6.0.0 || ^7.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "jspdf": "^4.0.0",
    "svg2pdf.js": "^2.7.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/re-sohail/fabricjs-document-engine.git"
  },
  "homepage": "https://fabricjs-document-engine.jscrate.dev",
  "bugs": {
    "url": "https://github.com/re-sohail/fabricjs-document-engine/issues"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.0.2",
    "ajv": "^8.20.0",
    "fabric": "^7.4.0",
    "fabric6": "npm:fabric@^6.9.1",
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^6.3.289",
    "playwright": "^1.63.0",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "svg2pdf.js": "^2.8.1",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "jspdf": {
      "optional": true
    },
    "svg2pdf.js": {
      "optional": true
    }
  }
}
